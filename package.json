{
  "name": "tasklist-tools",
  "author": "lumine-code",
  "description": "Task state management and navigation commands for tasklist files.",
  "repository": "https://github.com/lumine-code/tasklist-tools",
  "bugs": {
    "url": "https://github.com/lumine-code/tasklist-tools/issues"
  },
  "keywords": [
    "todo",
    "checkbox",
    "task-management",
    "toggle",
    "markdown"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": ">=1.100.0 <2.0.0"
  },
  "backgroundTips": [
    "You can tick a task off in a tasklist file with {{ 'tasklist-tools:toggle-tick' | keystroke }}"
  ],
  "main": "./lib/main",
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "activationCommands": {
    "atom-text-editor": [
      "tasklist-tools:toggle-tick",
      "tasklist-tools:set-as-high",
      "tasklist-tools:set-as-todo",
      "tasklist-tools:set-as-done",
      "tasklist-tools:set-as-fail",
      "tasklist-tools:set-as-info",
      "tasklist-tools:go-to-next-tick",
      "tasklist-tools:go-to-next-high",
      "tasklist-tools:go-to-next-todo",
      "tasklist-tools:go-to-next-done",
      "tasklist-tools:go-to-next-fail",
      "tasklist-tools:go-to-next-info",
      "tasklist-tools:translate-markdown",
      "tasklist-tools:move-items-to-last-header",
      "tasklist-tools:move-items-to-next-header",
      "tasklist-tools:move-to-last-header",
      "tasklist-tools:move-to-next-header",
      "tasklist-tools:move-to-previous-header"
    ]
  },
  "activationHooks": [
    "language-tasklist:grammar-used"
  ],
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    }
  },
  "configSchema": {
    "mouseToggle": {
      "title": "Mouse toggler",
      "description": "Middle-click to toggle the state of the task.",
      "type": "boolean",
      "default": true
    },
    "statusBar": {
      "title": "Status bar icons",
      "description": "Show task summary in the status bar.",
      "type": "boolean",
      "default": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
