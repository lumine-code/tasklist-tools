{
  "name": "tasklist-tools",
  "author": "lumine-code",
  "description": "Task state management and navigation commands for tasklist files.",
  "repository": "https://github.com/lumine-code/tasklist-tools",
  "bugs": {
    "url": "https://github.com/lumine-code/tasklist-tools/issues"
  },
  "keywords": [
    "todo",
    "checkbox",
    "task-management",
    "toggle",
    "markdown"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "specPackages": [
    "language-tasklist"
  ],
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    }
  },
  "configSchema": {
    "mouseToggle": {
      "title": "Mouse toggler",
      "description": "Middle-click to toggle the state of the task.",
      "type": "boolean",
      "default": true
    },
    "statusBar": {
      "title": "Status bar icons",
      "description": "Show task summary in the status bar.",
      "type": "boolean",
      "default": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
