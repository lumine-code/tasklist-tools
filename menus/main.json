              "submenu": [
                {
                  "label": "Under Next Header",
                  "command": "tasklist-tools:move-items-to-next-header"
                },
                {
                  "label": "Under Last Header",
                  "command": "tasklist-tools:move-items-to-last-header"
                }
              ]
            },
            {
              "label": "Convert Markdown Checkboxes and Bullets in File",
              "command": "tasklist-tools:translate-markdown"
            }
          ]
        }
      ]
    },
    {
      "label": "Edit",
      "submenu": [
        {
          "label": "Cycle Task State",
          "command": "tasklist-tools:toggle-tick",
          "group": "annotations",
          "order": 20
        }
      ]
    }
  ],
  "context-menu": {
    "lumine-text-editor[data-grammar~=\"tasklist\"]:not([mini])": [
      {
        "type": "separator"
      },
      {
        "label": "Cycle Task State",
        "command": "tasklist-tools:toggle-tick",
        "afterGroupContaining": ["core:select-all", "core:paste", "core:redo", "core:undo"],
        "group": "annotations",
        "order": 20
      },
      {
        "label": "Mark as High Priority",
        "command": "tasklist-tools:set-as-high",
        "group": "annotations",
        "order": 30
      },
      {
        "label": "Mark as To Do",
        "command": "tasklist-tools:set-as-todo",
        "group": "annotations",
        "order": 40
      },
      {
        "label": "Mark as Done",
        "command": "tasklist-tools:set-as-done",
        "group": "annotations",
        "order": 50
      },
      {
        "label": "Mark as Failed",
        "command": "tasklist-tools:set-as-fail",
        "group": "annotations",
        "order": 60
      },
      {
        "label": "Mark as Note",
        "command": "tasklist-tools:set-as-info",
        "group": "annotations",
        "order": 70
      },
      {
        "type": "separator"
      }
    ]
  }
